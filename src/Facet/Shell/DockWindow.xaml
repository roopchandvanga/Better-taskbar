<Window x:Class="Facet.Shell.DockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:apps="clr-namespace:Facet.Apps"
        Title="Facet Dock"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}" FontSize="12.5"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto">
    <!-- Transparent window holding only the dock's content. Its glass (live blur, tint, smooth rounded
         corners) is drawn by DockGlassWindow directly underneath, which owns this window. -->

    <Grid x:Name="Root" AllowDrop="True" DragOver="Root_DragOver" Drop="Root_Drop" PreviewMouseDown="Root_PreviewMouseDown" MouseLeftButtonDown="Root_MouseLeftButtonDown" MouseMove="Root_MouseMove"
          MouseLeftButtonUp="Root_MouseLeftButtonUp" MouseRightButtonUp="Root_MouseRightButtonUp">

        <!-- near-transparent over the live blur (hit-testable); the theme's solid tint if blur is unavailable -->
        <Border x:Name="GlassLayer" Background="#01000000" CornerRadius="{DynamicResource DockCorner}" />
        <!-- rim light along the glass edge (ThemeManager.ApplyDock: DockRim) -->
        <Border x:Name="Rim" CornerRadius="{DynamicResource DockCorner}" BorderThickness="1" BorderBrush="{DynamicResource DockRim}"
                IsHitTestVisible="False" />

        <Grid x:Name="DockContent" Margin="7,6" TextElement.Foreground="{DynamicResource DockForeground}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="SpacerColumn" Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Start + apps; AppStripAnimator magnifies the icons under the cursor and glides the active-app
                 line (ActiveBar, drawn over the icons' dot row) from app to app -->
            <!-- transparent background: the gaps between icons count as the strip too, so moving across
                 them keeps the magnification going instead of dropping it -->
            <Grid x:Name="AppArea" Background="Transparent">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="StartButton" Style="{StaticResource DockButton}" Width="{DynamicResource ItemSize}" Height="{DynamicResource ItemSize}"
                        Margin="{DynamicResource AppSpacing}" Click="StartButton_Click" ToolTip="Start">
                    <!-- Windows 11 logo: four panes forming a rounded square; only each pane's outer corner is
                         rounded, the corners facing the gap stay square -->
                    <Path x:Name="StartLogo" Fill="{DynamicResource StartLogo}" Stretch="Uniform"
                          Width="{DynamicResource StartLogoSize}" Height="{DynamicResource StartLogoSize}"
                          Data="M2.2,0 H9.4 V9.4 H0 V2.2 A2.2,2.2 0 0 1 2.2,0 Z
                                M10.6,0 H17.8 A2.2,2.2 0 0 1 20,2.2 V9.4 H10.6 Z
                                M0,10.6 H9.4 V20 H2.2 A2.2,2.2 0 0 1 0,17.8 Z
                                M10.6,10.6 H20 V17.8 A2.2,2.2 0 0 1 17.8,20 H10.6 Z" />
                </Button>

                <ItemsControl x:Name="AppsList" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type apps:AppItem}">
                            <Button Style="{StaticResource AppButton}" ToolTip="{Binding Tooltip}" Click="App_Click"
                                    MouseEnter="App_MouseEnter" MouseLeave="App_MouseLeave"
                                    PreviewMouseUp="App_PreviewMouseUp" MouseRightButtonUp="App_RightClick"
                                    AllowDrop="True" DragEnter="App_DragEnter" DragOver="App_DragOver"
                                    DragLeave="App_DragLeave" Drop="App_Drop" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <Canvas x:Name="IndicatorLayer" IsHitTestVisible="False">
                <Border x:Name="ActiveBar" Width="{DynamicResource BarWidth}" Height="{DynamicResource BarHeight}"
                        CornerRadius="{DynamicResource BarRadius}" Background="{DynamicResource Accent}" />
            </Canvas>
            </Grid>

            <Border x:Name="Divider" Grid.Column="1" Width="1" Margin="8,10" Background="{DynamicResource DockDivider}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal">
                <StackPanel x:Name="WidgetHost" Orientation="Horizontal" />
                <!-- clock and bell are transparent tiles with the same 3 px margins as the widgets (BuildWidgets),
                     so every gap between neighbouring tiles is 6 px -->
                <ContentControl x:Name="ClockHost" Focusable="False" Margin="3,0" VerticalAlignment="Center" />
                <!-- the notification bell, last on the dock (Settings.ShowNotifications) -->
                <ContentControl x:Name="NotificationsHost" Focusable="False" Margin="3,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
