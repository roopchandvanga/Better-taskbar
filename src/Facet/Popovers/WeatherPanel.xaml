<UserControl x:Class="Facet.Popovers.WeatherPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Facet.Controls">
    <UserControl.Resources>
        <c:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <c:BoolToVisibilityConverter x:Key="BoolToVis" />
        <c:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />
    </UserControl.Resources>
    <StackPanel Width="360">
        <DockPanel>
            <c:WeatherIcon DockPanel.Dock="Right" Kind="{Binding Kind}" IsDay="{Binding IsDay}" Width="64" Height="64" VerticalAlignment="Top" />
            <StackPanel>
                <TextBlock Text="{Binding City}" FontSize="15" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Temperature}" FontFamily="{StaticResource DisplayFont}" FontSize="52" FontWeight="Light" Margin="-2,-4,0,-4" />
                <TextBlock Text="{Binding Description}" FontSize="13" />
                <TextBlock Text="{Binding Range}" Style="{StaticResource Caption}" Margin="0,2,0,0" />
            </StackPanel>
        </DockPanel>

        <TextBlock Text="{Binding Status}" Style="{StaticResource Caption}" Margin="0,8,0,0" Visibility="{Binding Status, Converter={StaticResource NullToCollapsed}}" />

        <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="8,12" Visibility="{Binding Available, Converter={StaticResource BoolToVis}}">
            <ItemsControl ItemsSource="{Binding Daily}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Day}" FontSize="11.5" HorizontalAlignment="Center" Foreground="{DynamicResource SurfaceSubtle}" />
                            <c:WeatherIcon Kind="{Binding Kind}" IsDay="True" Width="26" Height="26" Margin="0,6" />
                            <TextBlock Text="{Binding High}" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Low}" FontSize="11.5" HorizontalAlignment="Center" Foreground="{DynamicResource SurfaceSubtle}" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <DockPanel Margin="2,10,0,0">
            <Button DockPanel.Dock="Right" Style="{StaticResource SurfaceGlyphButton}" Content="&#xE72C;" Click="Refresh_Click" ToolTip="Refresh" />
            <Button DockPanel.Dock="Right" Style="{StaticResource SurfaceGlyphButton}" Content="&#xE713;" Click="Settings_Click" ToolTip="Weather settings" />
            <TextBlock Text="Open-Meteo · no account, no tracking" Style="{StaticResource Caption}" FontSize="11" VerticalAlignment="Center" />
        </DockPanel>
    </StackPanel>
</UserControl>
