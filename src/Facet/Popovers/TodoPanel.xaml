<UserControl x:Class="Facet.Popovers.TodoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="330">
        <DockPanel Margin="0,0,0,12">
            <TextBlock DockPanel.Dock="Right" Text="{Binding Summary}" Style="{StaticResource Caption}" VerticalAlignment="Center" />
            <TextBlock Text="Todos" FontSize="16" FontWeight="SemiBold" />
        </DockPanel>

        <TextBox x:Name="Input" Style="{StaticResource SurfaceTextBox}" Tag="Add a todo and press Enter" KeyDown="Input_KeyDown" />

        <ScrollViewer Margin="0,10,0,0" MaxHeight="360" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Items}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="Row" Margin="0,1" Background="Transparent">
                            <Border x:Name="Hover" CornerRadius="8" Background="{DynamicResource SurfaceHover}" Opacity="0" />
                            <DockPanel Margin="6,7">
                                <CheckBox DockPanel.Dock="Left" Style="{StaticResource RoundCheck}" IsChecked="{Binding Done}" VerticalAlignment="Top" />
                                <Button x:Name="Del" DockPanel.Dock="Right" Style="{StaticResource SurfaceGlyphButton}" Width="24" Height="24" FontSize="11"
                                        Content="&#xE711;" Click="Delete_Click" Opacity="0" ToolTip="Delete" />
                                <TextBlock x:Name="Label" Text="{Binding Text}" TextWrapping="Wrap" Margin="10,1,4,0" />
                            </DockPanel>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Done}" Value="True">
                                <Setter TargetName="Label" Property="TextDecorations" Value="Strikethrough" />
                                <Setter TargetName="Label" Property="Opacity" Value="0.5" />
                            </DataTrigger>
                            <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="1" />
                                <Setter TargetName="Del" Property="Opacity" Value="1" />
                            </Trigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <TextBlock x:Name="Empty" Text="Nothing to do. Enjoy it." Style="{StaticResource Caption}" Margin="6,12,0,4" />
        <Button Style="{StaticResource LinkButton}" Content="Clear completed" HorizontalAlignment="Right" Margin="0,10,4,0" Click="Clear_Click" />
    </StackPanel>
</UserControl>
