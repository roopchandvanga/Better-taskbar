<UserControl x:Class="Facet.Popovers.MediaPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Facet.Controls">
    <UserControl.Resources>
        <c:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <c:NullToCollapsedConverter x:Key="NullToVisible" Invert="True" />
    </UserControl.Resources>
    <StackPanel Width="280">
        <Grid Width="280" Height="280">
            <Border CornerRadius="16" Background="{DynamicResource SurfaceCardStrong}">
                <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="64" Opacity="0.35"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisible}}" />
            </Border>
            <Border CornerRadius="16" Visibility="{Binding Thumbnail, Converter={StaticResource NullToCollapsed}}">
                <Border.Background>
                    <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                </Border.Background>
            </Border>
        </Grid>

        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Margin="2,14,2,0" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="{Binding Artist}" Style="{StaticResource Caption}" FontSize="13" Margin="2,2,2,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
        <TextBlock Text="{Binding AppName}" Style="{StaticResource Caption}" FontSize="11" Margin="2,2,2,0" Opacity="0.8" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
            <Button Style="{StaticResource SurfaceGlyphButton}" Width="44" Height="44" FontSize="18" Content="&#xE892;" Click="Prev_Click" ToolTip="Previous" />
            <Button x:Name="PlayButton" Style="{StaticResource SurfaceGlyphButton}" Width="56" Height="56" FontSize="24" Margin="14,0"
                    Background="{DynamicResource SurfaceCardStrong}" Click="Play_Click" ToolTip="Play / pause" />
            <Button Style="{StaticResource SurfaceGlyphButton}" Width="44" Height="44" FontSize="18" Content="&#xE893;" Click="Next_Click" ToolTip="Next" />
        </StackPanel>
    </StackPanel>
</UserControl>
