<?xml version="1.0" encoding="utf-8"?>
<!--
  A single Facet.exe that carries its own copy of .NET, so it runs on any 64-bit Windows 10 (1809+) / 11 PC
  without installing anything. Larger than the default build, which relies on the .NET 10 Desktop Runtime.

    dotnet publish src/Facet/Facet.csproj -p:PublishProfile=Standalone

  Output: publish-standalone\Facet.exe (for an ARM PC, add -r win-arm64).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF's native parts (graphics, text) go inside the exe too, unpacked on first run -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <!-- nor Facet.Core's debug symbols: just the exe -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildProjectDirectory)\..\..\publish-standalone\</PublishDir>
  </PropertyGroup>
</Project>
