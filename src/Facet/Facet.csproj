<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 22621 SDK projections (for ToastNotificationManagerForUser.NotificationMode); still runs on 17763+ -->
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\facet.ico</ApplicationIcon>
    <AssemblyName>Facet</AssemblyName>
    <RootNamespace>Facet</RootNamespace>
    <Version>0.1.0</Version>
    <Product>Facet</Product>
    <Description>A native smart dock for Windows</Description>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\facet.ico" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Facet.Core\Facet.Core.csproj" />
  </ItemGroup>

</Project>
