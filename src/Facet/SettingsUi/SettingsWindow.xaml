<Window x:Class="Facet.SettingsUi.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Facet Settings" Width="900" Height="680" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Background="{DynamicResource SettingsBackground}" Foreground="{DynamicResource SurfaceForeground}">
    <Window.Resources>
        <Style x:Key="Row" TargetType="Border" BasedOn="{StaticResource Card}" />
        <Style x:Key="Field" TargetType="TextBox" BasedOn="{StaticResource SurfaceTextBox}">
            <Setter Property="Margin" Value="0,6,0,0" />
        </Style>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="SmallButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- navigation -->
        <Border Background="{DynamicResource SurfaceCard}">
            <DockPanel Margin="14,20,14,16">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,0,22">
                    <Border Width="34" Height="34" CornerRadius="10">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#5AC8FA" Offset="0" />
                                <GradientStop Color="#0A84FF" Offset="0.5" />
                                <GradientStop Color="#BF5AF2" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Path Data="M12,3 L21,10 L17,21 L7,21 L3,10 Z M12,3 L12,21 M3,10 L21,10" Stroke="White" StrokeThickness="1.4"
                              Width="20" Height="20" Stretch="Uniform" StrokeLineJoin="Round" />
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Facet" FontSize="17" FontWeight="Bold" />
                        <TextBlock x:Name="VersionText" Style="{StaticResource Caption}" FontSize="11" />
                    </StackPanel>
                </StackPanel>
                <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Caption}" FontSize="11" Margin="8,0" TextWrapping="Wrap"
                           Text="No account. No telemetry. Everything stays in %AppData%\Facet." />
                <StackPanel x:Name="Nav">
                    <RadioButton Style="{StaticResource NavButton}" Content="Appearance" Tag="appearance" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Dock &amp; taskbar" Tag="dock" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Widgets" Tag="widgets" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Weather &amp; calendar" Tag="weather" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Alerts &amp; focus" Tag="alerts" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Custom widgets" Tag="custom" Checked="Nav_Checked" />
                    <RadioButton Style="{StaticResource NavButton}" Content="Data &amp; about" Tag="about" Checked="Nav_Checked" />
                </StackPanel>
            </DockPanel>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="32,24,32,32" MaxWidth="720" HorizontalAlignment="Left">

                <!-- APPEARANCE -->
                <StackPanel x:Name="PageAppearance" Tag="appearance">
                    <TextBlock Text="Appearance" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="How the dock looks. Changes apply instantly." Style="{StaticResource Caption}" />

                    <TextBlock Text="Theme" Style="{StaticResource SectionTitle}" />
                    <WrapPanel x:Name="ThemeChoices" />

                    <TextBlock Text="Size" Style="{StaticResource SectionTitle}" />
                    <WrapPanel x:Name="SizeChoices" />

                    <TextBlock Text="Shape" Style="{StaticResource SectionTitle}" />
                    <WrapPanel x:Name="LayoutChoices" />

                    <TextBlock Text="Edge" Style="{StaticResource SectionTitle}" />
                    <WrapPanel x:Name="EdgeChoices" />
                    <TextBlock Text="Tip: you can also drag the dock to the top or bottom of the screen." Style="{StaticResource Caption}" Margin="0,6,0,0" />

                    <TextBlock Text="Details" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Row}">
                        <CheckBox x:Name="Clock24" Style="{StaticResource Switch}" Content="24-hour clock" Click="Changed" />
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <CheckBox x:Name="ShowNotifications" Style="{StaticResource Switch}" Click="Changed">
                            <StackPanel>
                                <TextBlock Text="Notifications button" FontWeight="SemiBold" />
                                <TextBlock Text="A bell at the far right of the dock. It opens the Windows notification center, shows how many notifications arrived since you last opened it, and is crossed out while Windows' do not disturb is on." Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                </StackPanel>

                <!-- DOCK -->
                <StackPanel x:Name="PageDock" Tag="dock" Visibility="Collapsed">
                    <TextBlock Text="Dock &amp; taskbar" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="How Facet shares the screen with Windows." Style="{StaticResource Caption}" />

                    <TextBlock Text="Dock" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Row}">
                        <CheckBox x:Name="AutoHide" Style="{StaticResource Switch}" Click="Changed">
                            <StackPanel>
                                <TextBlock Text="Auto-hide the dock" FontWeight="SemiBold" />
                                <TextBlock Text="The dock stays out of sight and slides up when the cursor touches the bottom edge of the screen (top edge when docked at the top)." Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <TextBlock Text="Windows taskbar" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Row}">
                        <CheckBox x:Name="HideTaskbar" Style="{StaticResource Switch}" Click="Changed">
                            <StackPanel>
                                <TextBlock Text="Hide the Windows taskbar while Facet runs" FontWeight="SemiBold" />
                                <TextBlock Text="The Windows key still opens Start. The taskbar comes back when you quit Facet — and Facet restores it at the next launch if it ever exits unexpectedly." Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <CheckBox x:Name="ReserveSpace" Style="{StaticResource Switch}" Click="Changed">
                            <StackPanel>
                                <TextBlock Text="Reserve screen space" FontWeight="SemiBold" />
                                <TextBlock Text="Maximized windows stop at the dock instead of sliding under it." Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <CheckBox x:Name="HideInFullscreen" Style="{StaticResource Switch}" Click="Changed">
                            <StackPanel>
                                <TextBlock Text="Get out of the way in fullscreen" FontWeight="SemiBold" />
                                <TextBlock Text="Hide the dock while a game or video is fullscreen." Style="{StaticResource Caption}" />
                            </StackPanel>
                        </CheckBox>
                    </Border>

                    <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Row}">
                        <CheckBox x:Name="LaunchAtStartup" Style="{StaticResource Switch}" Content="Launch Facet when I sign in" Click="Changed" />
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <CheckBox x:Name="PaletteHotkey" Style="{StaticResource Switch}" Click="Changed">
                                <StackPanel>
                                    <TextBlock Text="Command palette shortcut" FontWeight="SemiBold" />
                                    <TextBlock Text="Launch apps, run actions, do math, open folders and add todos from the keyboard." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </CheckBox>
                            <WrapPanel x:Name="ShortcutChoices" Margin="0,10,0,0" />
                            <TextBlock x:Name="ShortcutStatus" Style="{StaticResource Caption}" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="Pinned apps" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Restore" Click="RestorePins_Click" Margin="0" />
                            <StackPanel>
                                <TextBlock Text="Hidden taskbar pins" FontWeight="SemiBold" />
                                <TextBlock x:Name="HiddenPinsText" Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- WIDGETS -->
                <StackPanel x:Name="PageWidgets" Tag="widgets" Visibility="Collapsed">
                    <TextBlock Text="Widgets" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Turn widgets on or off and choose their order on the dock." Style="{StaticResource Caption}" />
                    <StackPanel x:Name="WidgetList" Margin="0,16,0,0" />

                    <TextBlock Text="Quick controls tile" Style="{StaticResource SectionTitle}" />
                    <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                               Text="The buttons in the Wi-Fi &amp; Bluetooth tile, left to right. You can also turn them on and off by right-clicking the tile." />
                    <StackPanel x:Name="ConnectItemList" Margin="0,10,0,0" />
                </StackPanel>

                <!-- WEATHER & CALENDAR -->
                <StackPanel x:Name="PageWeather" Tag="weather" Visibility="Collapsed">
                    <TextBlock Text="Weather &amp; calendar" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Weather comes from Open-Meteo (free, no key). Calendars are read-only iCal links, refreshed every 15 minutes." Style="{StaticResource Caption}" />

                    <TextBlock Text="Weather location" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Style="{StaticResource AccentPillButton}" Content="Find" Margin="8,6,0,0" Click="FindCity_Click" />
                                <TextBox x:Name="City" Style="{StaticResource Field}" Tag="City, e.g. Lisbon or Bengaluru" KeyDown="City_KeyDown" />
                            </DockPanel>
                            <TextBlock x:Name="CityStatus" Style="{StaticResource Caption}" Margin="0,8,0,0" />
                            <Button Style="{StaticResource LinkButton}" Content="Use my Windows location instead" HorizontalAlignment="Left" Margin="0,8,0,0" Click="UseLocation_Click" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <CheckBox x:Name="Fahrenheit" Style="{StaticResource Switch}" Content="Show temperatures in °F" Click="Changed" />
                    </Border>

                    <TextBlock Text="Calendars (iCal links)" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap"
                                       Text="One link per line. Google: Settings → your calendar → 'Secret address in iCal format'. Outlook: Settings → Shared calendars → Publish → ICS. iCloud: share calendar publicly → copy link (webcal:// works)." />
                            <TextBox x:Name="ICalUrls" Style="{StaticResource Field}" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="90"
                                     VerticalContentAlignment="Top" Tag="https://calendar.google.com/calendar/ical/…/basic.ics" LostFocus="ICal_LostFocus" />
                            <DockPanel Margin="0,10,0,0">
                                <Button DockPanel.Dock="Left" Style="{StaticResource SmallButton}" Content="Save &amp; sync now" Click="SyncCalendars_Click" />
                                <TextBlock x:Name="CalendarStatus" Style="{StaticResource Caption}" VerticalAlignment="Center" />
                            </DockPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- ALERTS & FOCUS -->
                <StackPanel x:Name="PageAlerts" Tag="alerts" Visibility="Collapsed">
                    <TextBlock Text="Alerts &amp; focus" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="Facet's widgets watch things for you and speak up before you'd have to check." Style="{StaticResource Caption}" />

                    <TextBlock Text="Smart alerts" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="LeadMinutes" Style="{StaticResource SurfaceTextBox}" Width="54" LostFocus="Changed" />
                                <TextBlock Text="min before" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="EventSoon" Style="{StaticResource Switch}" Click="Changed" Margin="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="Upcoming events" FontWeight="SemiBold" />
                                    <TextBlock Text="Offers to pause your music when a meeting is about to start." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </CheckBox>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="BatteryThreshold" Style="{StaticResource SurfaceTextBox}" Width="54" LostFocus="Changed" />
                                <TextBlock Text="%" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="BatteryLow" Style="{StaticResource Switch}" Content="Low battery" Click="Changed" Margin="0,0,16,0" />
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="CpuThreshold" Style="{StaticResource SurfaceTextBox}" Width="54" LostFocus="Changed" />
                                <TextBlock Text="% for 1 min" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>
                            <CheckBox x:Name="CpuHot" Style="{StaticResource Switch}" Content="CPU running hot" Click="Changed" Margin="0,0,16,0" />
                        </DockPanel>
                    </Border>

                    <TextBlock Text="Quiet hours" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBox x:Name="QuietStart" Style="{StaticResource SurfaceTextBox}" Width="64" LostFocus="Changed" />
                                <TextBlock Text="to" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0" />
                                <TextBox x:Name="QuietEnd" Style="{StaticResource SurfaceTextBox}" Width="64" LostFocus="Changed" />
                            </StackPanel>
                            <CheckBox x:Name="QuietEnabled" Style="{StaticResource Switch}" Click="Changed" Margin="0,0,16,0">
                                <StackPanel>
                                    <TextBlock Text="Hold alerts during quiet hours" FontWeight="SemiBold" />
                                    <TextBlock Text="Held alerts appear afterwards if they still matter. Critical battery always gets through." Style="{StaticResource Caption}" />
                                </StackPanel>
                            </CheckBox>
                        </DockPanel>
                    </Border>

                    <TextBlock Text="Pomodoro" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Row}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Focus" VerticalAlignment="Center" Width="60" />
                            <TextBox x:Name="FocusMinutes" Style="{StaticResource SurfaceTextBox}" Width="54" LostFocus="Changed" />
                            <TextBlock Text="min" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,28,0" />
                            <TextBlock Text="Break" VerticalAlignment="Center" Width="50" />
                            <TextBox x:Name="BreakMinutes" Style="{StaticResource SurfaceTextBox}" Width="54" LostFocus="Changed" />
                            <TextBlock Text="min" Style="{StaticResource Caption}" VerticalAlignment="Center" Margin="8,0,0,0" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <CheckBox x:Name="QuietDuringFocus" Style="{StaticResource Switch}" Content="Hold alerts while a focus session runs" Click="Changed" />
                    </Border>
                </StackPanel>

                <!-- CUSTOM WIDGETS -->
                <StackPanel x:Name="PageCustom" Tag="custom" Visibility="Collapsed">
                    <TextBlock Text="Custom widgets" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Make a tile out of anything: a shell command (first line of output) or a URL (optionally pick a value out of JSON). Examples: BTC price from a public API, open GitHub issues, git branch, disk space." />

                    <DockPanel Margin="0,16,0,0">
                        <StackPanel DockPanel.Dock="Left" Width="200" Margin="0,0,16,0">
                            <ListBox x:Name="CustomList" Height="300" Background="{DynamicResource SurfaceCard}" BorderThickness="0"
                                     Foreground="{DynamicResource SurfaceForeground}" SelectionChanged="CustomList_SelectionChanged" DisplayMemberPath="Name" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Button Style="{StaticResource SmallButton}" Content="Add" Click="AddCustom_Click" />
                                <Button Style="{StaticResource SmallButton}" Content="Example" Click="AddExample_Click" />
                                <Button Style="{StaticResource SmallButton}" Content="Remove" Click="RemoveCustom_Click" />
                            </StackPanel>
                        </StackPanel>

                        <Border x:Name="CustomEditor" Style="{StaticResource Row}" IsEnabled="False">
                            <StackPanel>
                                <TextBlock Text="Name" FontWeight="SemiBold" />
                                <TextBox x:Name="CwName" Style="{StaticResource Field}" Tag="BTC" />
                                <TextBlock Text="Source" FontWeight="SemiBold" Margin="0,12,0,0" />
                                <WrapPanel Margin="0,6,0,0">
                                    <RadioButton x:Name="CwKindCommand" Style="{StaticResource Segment}" Content="Shell command" GroupName="cwkind" />
                                    <RadioButton x:Name="CwKindUrl" Style="{StaticResource Segment}" Content="URL (JSON or text)" GroupName="cwkind" />
                                </WrapPanel>
                                <TextBox x:Name="CwSource" Style="{StaticResource Field}" Tag="e.g. https://api.coinbase.com/v2/prices/BTC-USD/spot" />
                                <TextBlock Text="JSON path (optional)" FontWeight="SemiBold" Margin="0,12,0,0" />
                                <TextBox x:Name="CwPath" Style="{StaticResource Field}" Tag="e.g. data.amount" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition />
                                        <ColumnDefinition Width="10" />
                                        <ColumnDefinition />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Refresh (sec)" FontWeight="SemiBold" />
                                        <TextBox x:Name="CwInterval" Style="{StaticResource Field}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Prefix" FontWeight="SemiBold" />
                                        <TextBox x:Name="CwPrefix" Style="{StaticResource Field}" Tag="$" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="Suffix" FontWeight="SemiBold" />
                                        <TextBox x:Name="CwSuffix" Style="{StaticResource Field}" Tag="%" />
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="On click open (optional)" FontWeight="SemiBold" Margin="0,12,0,0" />
                                <TextBox x:Name="CwClick" Style="{StaticResource Field}" Tag="URL, file or app" />
                                <DockPanel Margin="0,14,0,0">
                                    <Button DockPanel.Dock="Left" Style="{StaticResource AccentPillButton}" Content="Save" Click="SaveCustom_Click" Margin="0,0,8,0" />
                                    <Button DockPanel.Dock="Left" Style="{StaticResource SmallButton}" Content="Test" Click="TestCustom_Click" />
                                    <TextBlock x:Name="CwTestResult" Style="{StaticResource Caption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                            </StackPanel>
                        </Border>
                    </DockPanel>
                </StackPanel>

                <!-- ABOUT -->
                <StackPanel x:Name="PageAbout" Tag="about" Visibility="Collapsed">
                    <TextBlock Text="Data &amp; about" Style="{StaticResource PageTitle}" />
                    <TextBlock Style="{StaticResource Caption}"
                               Text="Facet is a native Windows dock: no web runtime, no account, no server, no telemetry. Network use is limited to the weather and the calendar/custom-widget links you add." />

                    <TextBlock Text="Your data" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Row}">
                        <StackPanel>
                            <TextBlock x:Name="DataPath" TextWrapping="Wrap" />
                            <WrapPanel Margin="0,10,0,0">
                                <Button Style="{StaticResource SmallButton}" Content="Open folder" Click="OpenData_Click" />
                                <Button Style="{StaticResource SmallButton}" Content="Export settings…" Click="Export_Click" />
                                <Button Style="{StaticResource SmallButton}" Content="Import settings…" Click="Import_Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <TextBlock Text="App" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Style="{StaticResource SmallButton}" Content="Quit Facet" Click="Quit_Click" Margin="0" />
                            <StackPanel>
                                <TextBlock x:Name="AboutVersion" FontWeight="SemiBold" />
                                <TextBlock Text="Quitting restores the Windows taskbar." Style="{StaticResource Caption}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
