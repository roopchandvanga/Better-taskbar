<UserControl x:Class="Facet.Widgets.MediaWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="{Binding HasSession, Converter={StaticResource BoolToVis}}">
    <Button x:Name="Btn" Style="{StaticResource TileButton}" Padding="6,0,6,0" Click="Btn_Click" ToolTip="{Binding Title}">
        <StackPanel Orientation="Horizontal">
            <Grid Width="{DynamicResource ThumbSize}" Height="{DynamicResource ThumbSize}" VerticalAlignment="Center">
                <Border CornerRadius="8" Background="{DynamicResource DockHover}">
                    <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding Thumbnail, Converter={StaticResource NullToVisible}}" />
                </Border>
                <Border CornerRadius="8" Visibility="{Binding Thumbnail, Converter={StaticResource NullToCollapsed}}">
                    <Border.Background>
                        <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                    </Border.Background>
                </Border>
            </Grid>
            <StackPanel Margin="9,0,6,0" VerticalAlignment="Center" Width="120">
                <TextBlock Text="{Binding Title}" Style="{StaticResource TileText}" />
                <TextBlock Text="{Binding Artist}" Style="{StaticResource TileSubText}" />
            </StackPanel>
            <Button x:Name="PlayPause" Style="{StaticResource GlyphButton}" Click="PlayPause_Click" VerticalAlignment="Center" />
        </StackPanel>
    </Button>
</UserControl>
