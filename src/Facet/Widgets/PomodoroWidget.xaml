<UserControl x:Class="Facet.Widgets.PomodoroWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:Facet.Controls">
    <Button x:Name="Btn" Style="{StaticResource TileButton}" Padding="6,0,12,0" Click="Btn_Click" MouseRightButtonUp="Btn_RightClick"
            ToolTip="Click to start or pause · right-click for more">
        <StackPanel Orientation="Horizontal">
            <Grid Width="{DynamicResource RingSize}" Height="{DynamicResource RingSize}">
                <c:Ring x:Name="ProgressRing" Value="{Binding Progress}" StrokeThickness="3" />
                <TextBlock x:Name="Glyph" FontFamily="{StaticResource WidgetIconFont}" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="{Binding Display}" Style="{StaticResource TileText}" Typography.NumeralAlignment="Tabular" />
                <TextBlock Text="{Binding Label}" Style="{StaticResource TileSubText}" />
            </StackPanel>
        </StackPanel>
    </Button>
</UserControl>
