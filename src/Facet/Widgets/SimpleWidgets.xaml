<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:Facet.Controls"
                    xmlns:s="clr-namespace:Facet.Services">

    <c:LoadToBrushConverter x:Key="LoadToBrush" />
    <c:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <c:NullToCollapsedConverter x:Key="NullToVisible" Invert="True" />
    <c:BoolToVisibilityConverter x:Key="BoolToVis" />
    <c:BoolToVisibilityConverter x:Key="BoolToCollapsed" Invert="True" />
    <FontFamily x:Key="WidgetIconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Style x:Key="TileText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource DockFont}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="TileSubText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="{DynamicResource DockSmallFont}" />
        <Setter Property="Foreground" Value="{DynamicResource DockSubtle}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="RingNumber" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="RingCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="7.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource DockSubtle}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,-2,0,0" />
    </Style>

    <!-- Weather: icon + temperature -->
    <DataTemplate x:Key="WeatherTile" DataType="{x:Type s:WeatherService}">
        <StackPanel Orientation="Horizontal">
            <c:WeatherIcon Kind="{Binding Kind}" IsDay="{Binding IsDay}" Width="26" Height="26" VerticalAlignment="Center" />
            <TextBlock Text="{Binding Temperature}" Style="{StaticResource TileText}" FontSize="{DynamicResource DockBigFont}" Margin="6,0,0,0" />
        </StackPanel>
    </DataTemplate>

    <!-- System: CPU + RAM rings -->
    <DataTemplate x:Key="SystemTile" DataType="{x:Type s:SystemMonitor}">
        <StackPanel Orientation="Horizontal">
            <Grid Width="{DynamicResource RingSize}" Height="{DynamicResource RingSize}">
                <c:Ring Value="{Binding Cpu}" StrokeThickness="3" Fill="{Binding Cpu, Converter={StaticResource LoadToBrush}}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Cpu, StringFormat={}{0:0}}" Style="{StaticResource RingNumber}" />
                    <TextBlock Text="CPU" Style="{StaticResource RingCaption}" />
                </StackPanel>
            </Grid>
            <Grid Width="{DynamicResource RingSize}" Height="{DynamicResource RingSize}" Margin="6,0,0,0">
                <c:Ring Value="{Binding Ram}" StrokeThickness="3" Fill="{Binding Ram, Converter={StaticResource LoadToBrush}}" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Ram, StringFormat={}{0:0}}" Style="{StaticResource RingNumber}" />
                    <TextBlock Text="RAM" Style="{StaticResource RingCaption}" />
                </StackPanel>
            </Grid>
        </StackPanel>
    </DataTemplate>

    <!-- Todos: checklist glyph + open count -->
    <DataTemplate x:Key="TodosTile" DataType="{x:Type s:TodoService}">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE9D5;" FontFamily="{StaticResource WidgetIconFont}" FontSize="16" VerticalAlignment="Center" />
            <TextBlock Text="{Binding OpenCount}" Style="{StaticResource TileText}" Margin="7,0,0,0" />
        </StackPanel>
    </DataTemplate>

    <!-- Custom widget: label over value -->
    <DataTemplate x:Key="CustomTile" DataType="{x:Type s:CustomWidgetViewModel}">
        <StackPanel VerticalAlignment="Center" MaxWidth="160">
            <TextBlock Text="{Binding Name}" Style="{StaticResource TileSubText}" />
            <TextBlock Text="{Binding Value}" Style="{StaticResource TileText}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
