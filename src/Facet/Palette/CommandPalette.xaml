<Window x:Class="Facet.Palette.CommandPalette"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:Facet.Controls"
        Title="Facet Command Palette" WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Width="660" SizeToContent="Height" Background="Transparent" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0" UseAeroCaptionButtons="False" CornerRadius="0" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <c:NullToCollapsedConverter x:Key="NullToCollapsed" />
        <Style x:Key="ResultItem" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="10" Padding="10,8" Margin="0,1" Background="Transparent">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceCard}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceCardStrong}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Frame" Background="{DynamicResource SurfaceBackground}" TextElement.Foreground="{DynamicResource SurfaceForeground}">
        <StackPanel>
            <DockPanel Margin="20,16,18,16">
                <TextBlock DockPanel.Dock="Left" Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="18"
                           VerticalAlignment="Center" Foreground="{DynamicResource SurfaceSubtle}" />
                <Border DockPanel.Dock="Right" CornerRadius="6" Background="{DynamicResource SurfaceCard}" Padding="7,2" VerticalAlignment="Center">
                    <TextBlock Text="esc" FontSize="11" Foreground="{DynamicResource SurfaceSubtle}" />
                </Border>
                <Grid Margin="14,0,10,0">
                    <TextBlock x:Name="Hint" Text="Search apps, actions, folders… or type = 2*21" FontSize="19"
                               Foreground="{DynamicResource SurfaceSubtle}" IsHitTestVisible="False" VerticalAlignment="Center" />
                    <TextBox x:Name="Query" FontSize="19" Background="Transparent" BorderThickness="0" Padding="0"
                             Foreground="{DynamicResource SurfaceForeground}" CaretBrush="{DynamicResource SurfaceForeground}"
                             SelectionBrush="{DynamicResource Accent}" VerticalContentAlignment="Center"
                             TextChanged="Query_TextChanged" PreviewKeyDown="Query_PreviewKeyDown" />
                </Grid>
            </DockPanel>

            <Border x:Name="Separator" Height="1" Background="{DynamicResource SurfaceBorder}" />

            <ListBox x:Name="Results" MaxHeight="452" Margin="8,8,8,4" Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource ResultItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     Focusable="False" PreviewMouseLeftButtonUp="Results_Click">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel>
                            <Grid DockPanel.Dock="Left" Width="30" Height="30">
                                <Border CornerRadius="8" Background="{DynamicResource SurfaceCard}"
                                        Visibility="{Binding Glyph, Converter={StaticResource NullToCollapsed}}">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="{StaticResource IconFont}" FontSize="15"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Hint}" FontSize="11.5" Foreground="{DynamicResource SurfaceSubtle}"
                                       VerticalAlignment="Center" Margin="10,0,4,0" />
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding Subtitle}" FontSize="11.5" Foreground="{DynamicResource SurfaceSubtle}" TextTrimming="CharacterEllipsis"
                                           Visibility="{Binding Subtitle, Converter={StaticResource NullToCollapsed}}" />
                            </StackPanel>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="Footer" Margin="22,4,22,14" FontSize="11.5" Foreground="{DynamicResource SurfaceSubtle}"
                       Text="↑↓ select · Enter open · = math · &gt; run command · todo &lt;text&gt; · ? web search" />
        </StackPanel>
    </Border>
</Window>
